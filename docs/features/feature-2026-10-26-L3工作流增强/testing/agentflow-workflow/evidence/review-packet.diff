+        if (
+            not isinstance(argv, list)
+            or not argv
+            or any(not isinstance(x, str) or "\x00" in x for x in argv)
+            or not argv[0]
+        ):
+            raise WorkflowError("invalid-task", "argv must be a non-empty string array")
