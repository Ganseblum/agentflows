{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/bug-record.schema.json",
  "title": "Agentflow bug record frontmatter",
  "description": "Contract for the YAML frontmatter of a Markdown bug record under records/bugs/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bug_id",
    "title",
    "status",
    "severity",
    "error_kind",
    "attribution",
    "project",
    "files",
    "recorded_at"
  ],
  "properties": {
    "bug_id": {
      "type": "string",
      "pattern": "^BUG-[A-Z0-9][A-Z0-9._-]*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["open", "fixed-pending-review", "verified", "rejected"]
    },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "error_kind": {
      "enum": [
        "ai-ignored-doc",
        "ai-ignored-code",
        "missing-constraint",
        "hallucination",
        "logic-error",
        "host-compat",
        "environment",
        "other"
      ]
    },
    "attribution": {
      "enum": [
        "workflow_policy",
        "role_prompt",
        "context",
        "tool_or_host",
        "model_limit",
        "product_code",
        "evaluation",
        "unknown"
      ]
    },
    "project": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "affected_slices": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "recorded_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "source_revision": { "type": "string", "minLength": 1 },
    "agentflow_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "reviewer": { "type": "string", "minLength": 1 },
    "review_decision": {
      "enum": ["approved", "changes_requested", "blocked"]
    },
    "regression_status": { "enum": ["pass", "fail", "not-run"] },
    "rejection_reason": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "verified" } },
        "required": ["status"]
      },
      "then": {
        "required": ["reviewer", "review_decision", "regression_status"],
        "properties": {
          "review_decision": { "const": "approved" },
          "regression_status": { "const": "pass" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "fixed-pending-review" } },
        "required": ["status"]
      },
      "then": {
        "required": ["regression_status"]
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "rejected" } },
        "required": ["status"]
      },
      "then": {
        "required": ["rejection_reason"]
      }
    }
  ]
}
