{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/plan.schema.json",
  "title": "Agentflow execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "plan_version",
    "status",
    "objective",
    "non_goals",
    "assumptions",
    "input_evidence",
    "interfaces",
    "dependencies",
    "work_packages",
    "parallel_lanes",
    "acceptance_criteria",
    "verification",
    "review_gates",
    "rollback_points",
    "unresolved_decisions",
    "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": {
      "type": "string",
      "pattern": "^PLAN-[A-Z0-9][A-Z0-9._-]*$"
    },
    "recorded_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "plan_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": ["draft", "proposed", "approved", "superseded"]
    },
    "objective": { "type": "string", "minLength": 1 },
    "non_goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "input_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "source_ref"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "interface_id",
          "producer",
          "consumer",
          "contract",
          "error_behavior",
          "compatibility"
        ],
        "properties": {
          "interface_id": { "type": "string", "minLength": 1 },
          "producer": { "type": "string", "minLength": 1 },
          "consumer": { "type": "string", "minLength": 1 },
          "contract": { "type": "string", "minLength": 1 },
          "error_behavior": { "type": "string", "minLength": 1 },
          "compatibility": { "type": "string", "minLength": 1 },
          "verification_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dependency_id", "description", "blocking"],
        "properties": {
          "dependency_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "work_packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package_id",
          "owner",
          "scope",
          "deliverable",
          "depends_on",
          "verification"
        ],
        "properties": {
          "package_id": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "deliverable": { "type": "string", "minLength": 1 },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "verification": { "type": "string", "minLength": 1 },
          "files": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "parallel_lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane_id", "work_package_ids", "can_run_when"],
        "properties": {
          "lane_id": { "type": "string", "minLength": 1 },
          "work_package_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "can_run_when": { "type": "string", "minLength": 1 }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "criterion", "evidence"],
        "properties": {
          "criterion_id": { "type": "string", "minLength": 1 },
          "criterion": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "command", "expected"],
        "properties": {
          "check_id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "review_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "owner", "check", "decision"],
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "check": { "type": "string", "minLength": 1 },
          "decision": {
            "enum": ["required", "conditional", "informational"]
          }
        }
      }
    },
    "rollback_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point_id", "trigger", "action"],
        "properties": {
          "point_id": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unresolved_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "question", "needed_by"],
        "properties": {
          "decision_id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "needed_by": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "approved" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "unresolved_decisions": { "maxItems": 0 }
        }
      }
    }
  ]
}
