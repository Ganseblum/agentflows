{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/adapter-case-result.schema.json",
  "title": "Agentflow host adapter case result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted",
    "first_pass_review",
    "correction_count",
    "escaped_defects",
    "permission_violations",
    "unnecessary_delegation",
    "tool_failures",
    "latency_ms",
    "evidence_refs"
  ],
  "properties": {
    "accepted": { "type": "boolean" },
    "first_pass_review": { "type": "boolean" },
    "correction_count": { "type": "integer", "minimum": 0 },
    "escaped_defects": { "type": "integer", "minimum": 0 },
    "permission_violations": { "type": "integer", "minimum": 0 },
    "unnecessary_delegation": { "type": "boolean" },
    "tool_failures": { "type": "integer", "minimum": 0 },
    "latency_ms": { "type": "number", "minimum": 0 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
