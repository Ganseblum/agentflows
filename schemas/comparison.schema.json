{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/comparison.schema.json",
  "title": "Agentflow baseline/candidate comparison produced by eval_runner.py compare",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_result_id",
    "candidate_result_id",
    "context",
    "deltas",
    "baseline_summary",
    "candidate_summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "baseline_result_id": { "type": "string", "minLength": 1 },
    "candidate_result_id": { "type": "string", "minLength": 1 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_revision",
        "host",
        "model",
        "permissions_profile",
        "fixture_revision",
        "repeat_count",
        "suite_case_count"
      ],
      "properties": {
        "suite_revision": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "permissions_profile": { "type": "string", "minLength": 1 },
        "fixture_revision": { "type": "string", "minLength": 1 },
        "repeat_count": { "type": "integer", "minimum": 1 },
        "suite_case_count": { "type": "integer", "minimum": 1 }
      }
    },
    "deltas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_rate",
        "first_pass_review_rate",
        "correction_count",
        "escaped_defects",
        "permission_violations",
        "unnecessary_delegation_count",
        "tool_failures",
        "latency_ms"
      ],
      "properties": {
        "acceptance_rate": { "type": "number" },
        "first_pass_review_rate": { "type": "number" },
        "correction_count": { "type": "number" },
        "escaped_defects": { "type": "number" },
        "permission_violations": { "type": "number" },
        "unnecessary_delegation_count": { "type": "number" },
        "tool_failures": { "type": "number" },
        "latency_ms": { "type": "number" }
      }
    },
    "baseline_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_rate",
        "first_pass_review_rate",
        "correction_count",
        "escaped_defects",
        "permission_violations",
        "unnecessary_delegation_count",
        "tool_failures",
        "latency_ms"
      ],
      "properties": {
        "acceptance_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "first_pass_review_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "correction_count": { "type": "integer", "minimum": 0 },
        "escaped_defects": { "type": "integer", "minimum": 0 },
        "permission_violations": { "type": "integer", "minimum": 0 },
        "unnecessary_delegation_count": { "type": "integer", "minimum": 0 },
        "tool_failures": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "number", "minimum": 0 }
      }
    },
    "candidate_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_rate",
        "first_pass_review_rate",
        "correction_count",
        "escaped_defects",
        "permission_violations",
        "unnecessary_delegation_count",
        "tool_failures",
        "latency_ms"
      ],
      "properties": {
        "acceptance_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "first_pass_review_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "correction_count": { "type": "integer", "minimum": 0 },
        "escaped_defects": { "type": "integer", "minimum": 0 },
        "permission_violations": { "type": "integer", "minimum": 0 },
        "unnecessary_delegation_count": { "type": "integer", "minimum": 0 },
        "tool_failures": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "number", "minimum": 0 }
      }
    }
  }
}
