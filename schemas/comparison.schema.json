{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/comparison.schema.json",
  "title": "Agentflow baseline/candidate comparison produced by eval_runner.py compare",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_result_id",
    "candidate_result_id",
    "context",
    "deltas",
    "baseline_summary",
    "candidate_summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "baseline_result_id": { "type": "string", "minLength": 1 },
    "candidate_result_id": { "type": "string", "minLength": 1 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_revision",
        "host",
        "model",
        "permissions_profile",
        "fixture_revision",
        "repeat_count",
        "suite_case_count"
      ],
      "properties": {
        "suite_revision": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "permissions_profile": { "type": "string", "minLength": 1 },
        "fixture_revision": { "type": "string", "minLength": 1 },
        "repeat_count": { "type": "integer", "minimum": 1 },
        "suite_case_count": { "type": "integer", "minimum": 1 }
      }
    },
    "deltas": { "$ref": "metrics.schema.json#/$defs/metricDeltas" },
    "baseline_summary": { "$ref": "metrics.schema.json#/$defs/metricSummary" },
    "candidate_summary": { "$ref": "metrics.schema.json#/$defs/metricSummary" }
  }
}
