{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/improvement/business-case.schema.json",
  "title": "Agentflow business evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "slice",
    "objective",
    "input_ref",
    "acceptance_criteria",
    "protected_guardrails",
    "holdout",
    "repeat_count",
    "target_id",
    "target_pin",
    "target_docs",
    "seeds_ref",
    "findings_contract",
    "grading"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "slice": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "input_ref": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protected_guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "holdout": {
      "const": false
    },
    "repeat_count": {
      "const": 3
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "target_pin": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target_docs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "seeds_ref": {
      "type": "string",
      "minLength": 1
    },
    "findings_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_pattern",
        "format",
        "required_fields"
      ],
      "properties": {
        "path_pattern": {
          "const": "findings/{case_id}/rep-{rep}/findings.json"
        },
        "format": {
          "const": "json"
        },
        "required_fields": {
          "const": [
            "path",
            "issue",
            "evidence"
          ]
        }
      }
    },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_seed_recall"
      ],
      "properties": {
        "min_seed_recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
