{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/improvement/episode.schema.json",
  "title": "Agentflow improvement evidence episode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "source_type",
    "objective",
    "outcome",
    "signals",
    "feedback_summary",
    "agentflow_version",
    "host",
    "provenance",
    "redactions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "user_feedback",
        "acceptance",
        "test",
        "review",
        "incident",
        "rollback"
      ]
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "base"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "started_at",
        "ended_at"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim",
          "status",
          "check"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "unverified",
              "failed"
            ]
          },
          "check": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "kind",
          "ref"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "accepted",
        "rejected",
        "partial",
        "failed",
        "unknown"
      ]
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      }
    },
    "review_roundtrips": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "reviewer",
          "decision",
          "finding",
          "resolution"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "approved",
              "changes_requested",
              "blocked"
            ]
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      }
    },
    "feedback_summary": {
      "type": "string"
    },
    "agentflow_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "host": {
      "enum": [
        "codex",
        "claude-code",
        "other"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier",
        "sanitized"
      ],
      "properties": {
        "carrier": {
          "type": "string",
          "minLength": 1
        },
        "sanitized": {
          "type": "boolean"
        }
      }
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
