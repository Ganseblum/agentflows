{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/improvement/episode.schema.json",
  "title": "Agentflow improvement evidence episode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "source_type",
    "objective",
    "outcome",
    "signals",
    "feedback_summary",
    "agentflow_version",
    "host",
    "provenance",
    "redactions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "user_feedback",
        "acceptance",
        "test",
        "review",
        "incident",
        "rollback"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "accepted",
        "rejected",
        "partial",
        "failed",
        "unknown"
      ]
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      }
    },
    "feedback_summary": {
      "type": "string"
    },
    "agentflow_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "host": {
      "enum": [
        "codex",
        "claude-code",
        "other"
      ]
    },
    "provenance": {
      "type": "object"
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
