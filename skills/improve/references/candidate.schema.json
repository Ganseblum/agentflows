{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/improvement/candidate.schema.json",
  "title": "Agentflow improvement candidate",
  "description": "Predeclaration of one bounded improvement candidate. The public suite and business slices were retired with the 2026-10-12 evaluation-apparatus removal (design knowledge in docs/design-decisions.md §3), so primary_metrics, guardrails and protected_slices are declared as intent, not machine-measured — a method-level candidate carries measurement: none and its evidence is reasoning plus the incident or review finding that triggered it. artifact_digest binds the candidate tree itself, not a suite. Restore a suite_revision field together with the apparatus.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_version",
    "parent_version",
    "source_revision",
    "artifact_digest",
    "hypothesis",
    "evidence_ids",
    "changed_components",
    "risk_class",
    "primary_metrics",
    "guardrails",
    "rejection_criteria",
    "protected_slices"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "parent_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changed_components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_class": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "primary_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rejection_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protected_slices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
