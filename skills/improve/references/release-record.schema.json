{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/improvement/release-record.schema.json",
  "title": "Agentflow improvement release record",
  "description": "The completed gate's record. Promotion rule (the same rule stated in skills/improve/SKILL.md and references/evidence-and-release.md): with measurement.status 'complete' a promote needs evaluation_result 'better'; with measurement.status 'none' (every method-level change since the 2026-10-12 apparatus removal) a promote needs measurement.basis to name the human review and an approved approval carrying an evidence_ref — no instrumented 'better' exists to point at. Baseline and candidate result sets are required only when measurement.status is 'complete'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "measurement",
    "evaluation_result",
    "decision",
    "approvals",
    "rollout",
    "rollback_to"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate": {
      "$ref": "candidate.schema.json"
    },
    "baseline_results": {
      "$ref": "#/$defs/resultSet"
    },
    "candidate_results": {
      "$ref": "#/$defs/resultSet"
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "none"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evaluation_result": {
      "enum": [
        "better",
        "neutral",
        "worse",
        "invalid"
      ]
    },
    "decision": {
      "enum": [
        "promote",
        "revise",
        "reject",
        "rollback"
      ]
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor",
          "decision"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "evidence_ref": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "human-gated",
            "canary",
            "automatic"
          ]
        },
        "task_slice": {
          "type": "string"
        },
        "rollback_thresholds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rollback_to": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "measurement": {
            "properties": {
              "status": {
                "const": "none"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "measurement"
        ]
      },
      "then": {
        "properties": {
          "measurement": {
            "properties": {
              "basis": {
                "pattern": "none|not measured|no instrument|[Hh]uman[ _-]?[Rr]eview|人工评审"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "measurement": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "measurement"
        ]
      },
      "then": {
        "required": [
          "baseline_results",
          "candidate_results"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "measurement": {
            "properties": {
              "status": {
                "const": "none"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "measurement"
        ]
      },
      "then": {
        "properties": {
          "evaluation_result": {
            "not": {
              "enum": [
                "better"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "promote"
          },
          "measurement": {
            "properties": {
              "status": {
                "const": "none"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "decision",
          "measurement"
        ]
      },
      "then": {
        "properties": {
          "measurement": {
            "properties": {
              "basis": {
                "pattern": "[Hh]uman[ _-]?[Rr]eview|人工评审"
              }
            }
          },
          "approvals": {
            "contains": {
              "type": "object",
              "properties": {
                "decision": {
                  "const": "approved"
                },
                "evidence_ref": {
                  "minLength": 1
                }
              },
              "required": [
                "decision",
                "evidence_ref"
              ]
            },
            "minContains": 1
          },
          "rollout": {
            "properties": {
              "mode": {
                "enum": [
                  "human-gated",
                  "canary",
                  "automatic"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "promote"
          },
          "measurement": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "decision",
          "measurement"
        ]
      },
      "then": {
        "properties": {
          "evaluation_result": {
            "const": "better"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "promote"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "approvals": {
            "contains": {
              "type": "object",
              "properties": {
                "decision": {
                  "const": "approved"
                }
              },
              "required": [
                "decision"
              ]
            },
            "minContains": 1
          },
          "rollout": {
            "properties": {
              "mode": {
                "enum": [
                  "human-gated",
                  "canary",
                  "automatic"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "candidate": {
            "properties": {
              "risk_class": {
                "const": "high"
              }
            },
            "required": [
              "risk_class"
            ]
          }
        },
        "required": [
          "candidate"
        ]
      },
      "then": {
        "properties": {
          "rollout": {
            "properties": {
              "mode": {
                "enum": [
                  "none",
                  "human-gated"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rollout": {
            "properties": {
              "mode": {
                "const": "canary"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "rollout"
        ]
      },
      "then": {
        "properties": {
          "rollout": {
            "required": [
              "task_slice",
              "rollback_thresholds"
            ],
            "properties": {
              "task_slice": {
                "minLength": 1
              },
              "rollback_thresholds": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rollout": {
            "properties": {
              "mode": {
                "const": "automatic"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "rollout"
        ]
      },
      "then": {
        "properties": {
          "candidate": {
            "properties": {
              "risk_class": {
                "const": "low"
              }
            }
          },
          "evaluation_result": {
            "const": "better"
          },
          "rollout": {
            "required": [
              "rollback_thresholds"
            ],
            "properties": {
              "rollback_thresholds": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "resultSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "source_kind",
        "source_revision",
        "artifact_digest",
        "suite_revision",
        "host",
        "model",
        "permissions_profile",
        "fixture_revision",
        "repeat_count",
        "suite_case_count",
        "summary",
        "uncertainty",
        "evidence_refs"
      ],
      "properties": {
        "result_id": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "enum": [
            "baseline",
            "candidate"
          ]
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "suite_revision": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "permissions_profile": {
          "type": "string",
          "minLength": 1
        },
        "fixture_revision": {
          "type": "string",
          "minLength": 1
        },
        "repeat_count": {
          "type": "integer",
          "minimum": 1
        },
        "suite_case_count": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acceptance_rate",
            "first_pass_review_rate",
            "correction_count",
            "escaped_defects",
            "permission_violations",
            "unnecessary_delegation_count",
            "tool_failures",
            "latency_ms"
          ],
          "properties": {
            "acceptance_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "first_pass_review_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "correction_count": {
              "type": "integer",
              "minimum": 0
            },
            "escaped_defects": {
              "type": "integer",
              "minimum": 0
            },
            "permission_violations": {
              "type": "integer",
              "minimum": 0
            },
            "unnecessary_delegation_count": {
              "type": "integer",
              "minimum": 0
            },
            "tool_failures": {
              "type": "integer",
              "minimum": 0
            },
            "latency_ms": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "uncertainty": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
