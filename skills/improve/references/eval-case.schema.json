{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/improvement/eval-case.schema.json",
  "title": "Agentflow improvement evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "slice",
    "objective",
    "input_ref",
    "acceptance_criteria",
    "protected_guardrails",
    "holdout",
    "repeat_count"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "slice": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "input_ref": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protected_guardrails": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "holdout": {
      "type": "boolean"
    },
    "repeat_count": {
      "type": "integer",
      "minimum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
